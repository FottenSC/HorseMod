{
  "name": "sc6-moveset-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack:cf": "powershell -NoProfile -ExecutionPolicy Bypass -File build-cloudflare.ps1",
