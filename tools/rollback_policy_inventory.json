{
  "schema_version": 1,
  "classification": "static-policy-only",
  "release_correctness_evidence": false,
  "checks": [
    {
      "id": "forbidden-legacy-entry-points",
      "signals": ["source_ok"],
      "invariant": "Removed debug, direct-connect, and superseded rollback entry points cannot be reintroduced.",
      "replacement": "dedicated-lint"
    },
    {
      "id": "production-lab-ownership",
      "signals": ["driver_ownership_ok", "manual_attach_observer_ok"],
      "invariant": "The stock lab driver owns lab navigation state and the production runtime has no dependency on the P2P/UI harness.",
      "replacement": "interface-boundary-plus-lint"
    },
    {
      "id": "stage-wind-snapshot-authority",
      "signals": ["stock_wind_rng_source_ok", "stock_wind_rng_source_negative_ok"],
      "invariant": "Stage-wind allocation ownership, graph capture/restore, and authority serialization remain ordered and bounded.",
      "replacement": "characterization-tests-in-progress"
    },
    {
      "id": "diagnostic-emission-order",
      "signals": ["baseline_diagnostic_source_audit_negative_ok"],
      "invariant": "Round-boundary and candidate diagnostics are populated before their one-shot emission latch is committed.",
      "replacement": "negative-control-lint"
    },
    {
      "id": "inter-round-control-order",
      "signals": [
        "zero_delta_runtime_source_order_ok",
        "zero_delta_helper_definitions_ok",
        "zero_delta_source_audit_negative_ok",
        "native_inter_round_pass_through_source_ok",
        "native_inter_round_pass_through_helpers_ok",
        "native_pass_source_audit_negative_ok",
        "native_controlled_source_ok",
        "native_controlled_source_negative_ok",
        "pre_new_round_edge_audit_ok",
        "native_terminal_handoff_ok"
      ],
      "invariant": "Native terminal release, zero-delta control, held transitions, and pre-new-round edges occur in the required lifecycle order.",
      "replacement": "characterization-tests-in-progress"
    },
    {
      "id": "baseline-storage-lifetime",
      "signals": ["frozen_baseline_ok", "round_rearm_arena_ok"],
      "invariant": "Frozen initial baselines remain immutable and round-rearm stores are prepared before capture without recycling live state.",
      "replacement": "snapshot-and-replay-tests"
    },
    {
      "id": "hook-install-lifetime",
      "signals": ["install_once_process_event_ok", "install_once_native_hooks_ok"],
      "invariant": "Ordinary session shutdown leaves reusable detours installed; only typed module-unload preparation detaches them.",
      "replacement": "typed-unload-contract-plus-lint"
    },
    {
      "id": "replay-evidence-provenance",
      "signals": [
        "beta_oracle_artifact_binding_source_ok",
        "replay_control_origin_source_ok",
        "fixture_provenance_source_ok",
        "fixture_runtime_order_ok",
        "primary_report_source_ok"
      ],
      "invariant": "Replay comparisons bind the expected artifact, source origin, fixture identity, runtime ordering, and immutable primary report.",
      "replacement": "golden-manifest-and-behavior-tests"
    },
    {
      "id": "presentation-and-authority-commit",
      "signals": [
        "palette_writer_source_ok",
        "carried_authority_source_ok",
        "authority_failure_preservation_ok",
        "presentation_install_diagnostics_ok",
        "scheduled_release_source_ok"
      ],
      "invariant": "Presentation effects and carried authority commit only after confirmation, and failure/install diagnostics are retained.",
      "replacement": "confirmed-frame-characterization-tests-in-progress"
    },
    {
      "id": "live-rate-policy",
      "signals": ["stable_battle_rate_gate_ok"],
      "invariant": "Live qualification requires continuous stable battle-rate windows and cannot pass on a single sample.",
      "replacement": "behavior-test-plus-lint"
    }
  ]
}
