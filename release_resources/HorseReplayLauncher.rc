#include "HorseReplayLauncherResource.h"
#include <winver.h>

#ifndef HORSEMOD_VERSION
#define HORSEMOD_VERSION "dev"
#endif

#ifndef HORSEMOD_VERSION_MAJOR
#define HORSEMOD_VERSION_MAJOR 0
#endif
#ifndef HORSEMOD_VERSION_MINOR
#define HORSEMOD_VERSION_MINOR 0
#endif
#ifndef HORSEMOD_VERSION_PATCH
#define HORSEMOD_VERSION_PATCH 0
#endif

IDI_HORSE_REPLAY_APP ICON "replay_notification.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HORSEMOD_VERSION_MAJOR,HORSEMOD_VERSION_MINOR,HORSEMOD_VERSION_PATCH,0
 PRODUCTVERSION HORSEMOD_VERSION_MAJOR,HORSEMOD_VERSION_MINOR,HORSEMOD_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HorseMod\0"
            VALUE "FileDescription", "HorseMod Replay Launcher\0"
            VALUE "FileVersion", HORSEMOD_VERSION "\0"
            VALUE "InternalName", "HorseReplayLauncher\0"
            VALUE "OriginalFilename", "HorseReplayLauncher.exe\0"
            VALUE "ProductName", "HorseMod\0"
            VALUE "ProductVersion", HORSEMOD_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
